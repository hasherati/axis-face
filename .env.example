# Server & Timezone
TZ=America/Los_Angeles
WEB_PORT=8000

# Options: auto (use GPU if passed through, else CPU), gpu (force GPU), cpu (force CPU)
EXECUTION_MODE=CPU

# MQTT Settings
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=axis_user
MQTT_PASSWORD=axis_password
MQTT_TOPIC_FILTER=+/scene/object_snapshot/v1/#

# Recognition & Storage Rules
MAX_IMAGES_PER_HOUR=3
SIMILARITY_THRESHOLD=0.45
DATA_DIR=/data

# Email Alert Settings
ALERT_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_gmail_account@gmail.com
SMTP_PASSWORD=your_gmail_app_password
ALERT_FROM_EMAIL=your_gmail_account@gmail.com
ALERT_TO_EMAIL=your_gmail_account@gmail.com
ALERT_ON_KNOWN=false
ALERT_ON_UNKNOWN=true
ALERT_COOLDOWN_MINUTES=15

# Web UI Authentication, guest can view but can't make changes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
GUEST_USERNAME=guest
GUEST_PASSWORD=change_me
SESSION_SECRET=axis_face_secret_change_me